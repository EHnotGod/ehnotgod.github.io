---
import PageLayout from '@/layouts/CommonPage.astro'
import {
  PublicationSection,
  ResearchProjectSection,
  SimpleIcon
} from '@/components/user'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'publications', text: 'Publications' },
  { depth: 2, slug: 'open-source-projects', text: 'Open-source Projects' }
]
---

<PageLayout title='Academic' {headings} info={{ slug: '/en/academic', hideComment: true }}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <p>
    I'm Yihang Liu (EH), an undergraduate in Statistics (Data Science & AI) at Shandong University.
    I'm currently doing research on generative AI and large models, covering image generation,
    multimodality and 3D trajectory prediction.
  </p>
  <p>
    I'm interested in preserving visual quality and structural consistency in generative models,
    as well as building more reliable and auditable evaluation frameworks. Feel free to reach out.
  </p>

  <h2 id='research-interests'>Research Interests<a class='anchor' href='#research-interests'>#</a></h2>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
    {
      [
        {
          title: 'Image Generation & Texture Editing',
          description: 'Text-driven image / texture editing, structure preservation, RL in generative models.',
          icon: 'pytorch'
        },
        {
          title: 'Multimodal LLM Auditing',
          description: 'Prompt-level generation quality prediction, benchmark construction, robustness analysis.',
          icon: 'huggingface'
        },
        {
          title: '3D Trajectory Prediction',
          description: 'SE(3)-equivariant Flow Matching, geometric deep learning, trajectory uncertainty modeling.',
          icon: 'ros'
        }
      ].map((interest) => (
        <div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:border-foreground/25 hover:shadow-md'>
          <div class='flex items-start gap-4'>
            <div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'>
              <SimpleIcon
                class='size-5 text-primary transition-transform duration-300 group-hover:scale-110'
                name={interest.icon}
              />
            </div>
            <div class='flex-1'>
              <p class='text-xl font-medium leading-tight text-foreground transition-colors group-hover:text-primary'>
                {interest.title}
              </p>
              <p class='text-sm leading-relaxed text-muted-foreground'>{interest.description}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <h2 id='publications'>Publications<a class='anchor' href='#publications'>#</a></h2>
  <PublicationSection
    publications={[
      {
        title: 'TexEditor: Structure-Preserving Text-Driven Texture Editing',
        authors: [
          { name: 'Bo Zhao' },
          { name: 'Yihang Liu', isMe: true },
          { name: 'Chenfeng Zhang' },
          { name: 'Huan Yang' },
          { name: 'Kun Gai' },
          { name: 'Wei Ji' }
        ],
        venue: 'ICML',
        year: '2026',
        type: 'conference',
        abstract:
          'Built on Qwen-Image, introducing a high-quality supervised dataset TexBlender with structural priors and an RL method StructureNFT that transfers structural constraints to real-world generation; also constructs the TexBench benchmark. Achieves SOTA on the main test set.',
        links: [{ type: 'arxiv', href: 'https://arxiv.org/abs/2603.18488' }, 
        {type: 'website', href: 'https://icml.cc/virtual/2026/poster/61988'},
        {type: 'github', href: 'https://github.com/KlingAIResearch/TexEditor'},
        {type: 'modelscope', href: 'https://www.modelscope.cn/datasets/zhaohhh2000/TexBench'}],
        status: 'accepted'
      },
      {
        title: 'GSE-Flow: Geometric SE(3)-Equivariant Flow Matching for 3D Trajectory Prediction',
        authors: [
          { name: 'Junwei Wu' },
          { name: 'Yihang Liu', isMe: true },
          { name: 'Ruixuan Yu' },
          { name: 'Jian Sun' }
        ],
        venue: 'ICML',
        year: '2026',
        type: 'conference',
        abstract:
          'SE(3)-equivariant Flow Matching framework for 3D trajectory prediction; responsible for baseline reproduction, multi-dataset comparisons, hyperparameter sensitivity and ablation studies. Achieves SOTA on MD17, MD22 and CMU MoCap.',
        links: [
          { type: 'website', href: 'https://icml.cc/virtual/2026/poster/65379' },
          { type: 'github', href: 'https://github.com/aegine/GSE-Flow' }
        ],
        status: 'accepted'
      },
      {
        title: 'A Critical Look at Prompt-Level Performance Prediction "Illusion" in Modern T2I Models',
        authors: [],
        venue: 'ICLR',
        year: '2026',
        type: 'conference',
        abstract:
          'An auditing framework covering models such as Qwen, FLUX and Boogu under various sampling configs, jointly analyzing GM/AM scores, R² across samples, extreme-sample detection and budget-constrained routing. Finds that high overall R² largely comes from coarse recognition of clearly-failed samples.',
        links: [],
        status: 'under-review'
      },
      {
        title: 'LLM-based Operational Risk Assessment and Inference for Power Systems',
        authors: [
          { name: 'Wenqi Huang' },
          { name: 'Bo Zhao' },
          { name: 'Yihang Liu', isMe: true },
          { name: 'Qiaoqiao Li' },
          { name: 'Jiaxuan Hou' },
          { name: 'Rui Su' },
          { name: 'Zhen Zhao' }
        ],
        venue: 'Automation of Electric Power Systems',
        year: '2026',
        type: 'journal',
        abstract:
          'LLM-based power system operational risk assessment, responsible for risk assessment strategy design, GRPO reinforcement learning training, experimental validation and writing, improving risk-classification accuracy and reasoning ability.',
        links: [{ type: 'website', href: 'https://kns.cnki.net/kcms2/article/abstract?v=jXpGf_Tis3BO7y3TyZruUOK4DTQA5k7-c4YVlxn6-g-K10dRgZu67wrfTJA6yg9exDs8aiF8MkQYtZG6msQfv2aAIrUdzYJ3XCLsVKbu95n9RK-sOUDFGXVJNUCFpZp1LUMV2DieHCFFuMYHbu2Y00Yfd-KSRAf_&uniplatform=NZKPT' }],
        status: 'published'
      }
    ]}
  />

  <h2 id='open-source-projects'>Open-source Projects<a class='anchor' href='#open-source-projects'>#</a></h2>
  <ResearchProjectSection
    projects={[
      {
        title: 'EH Algorithm Template Library',
        description: 'Data structures / graph theory / number theory / string templates accumulated in competitive programming, continuously updated.',
        category: 'Competitive Programming',
        status: 'active',
        links: [{ type: 'github', href: 'https://github.com/ehnotgod', label: 'Code' }]
      }
    ]}
  />
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>
