---
import PageLayout from '@/layouts/CommonPage.astro'
import { PublicationSection } from '@/components/user'
import { localizeEducation } from '@/data/education'
import { localizePublications } from '@/data/publications'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'publications', text: 'Publications' }
]
---

<PageLayout title='Academic' {headings} info={{ slug: '/en/academic', hideComment: true }}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <p>
    I'm EH, an undergraduate in Statistics (Data Science & AI) at Shandong University, currently
    doing research at the Media Computing Lab, Nankai University. My research focuses on
    image editing and restoration. Feel free to reach out.
  </p>

  <h2 id='education'>Education<a class='anchor' href='#education'>#</a></h2>
  {/* 教育经历统一放在 src/data/education.ts */}
  <ul class='space-y-3'>
    {
      localizeEducation('en').map((entry) => (
        <li class='rounded-lg border border-border px-4 py-3'>
          <div class='flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1'>
            <span class='font-medium'>{entry.school}</span>
            <span class='text-sm text-muted-foreground'>{entry.period}</span>
          </div>
          <p class='mt-0.5 text-sm text-muted-foreground'>
            {entry.department}
            {entry.location && <span> · {entry.location}</span>}
          </p>
        </li>
      ))
    }
  </ul>

  <h2 id='publications'>Publications<a class='anchor' href='#publications'>#</a></h2>
  {/* 论文数据统一放在 src/data/publications.ts：改链接 / 加论文只改那一处，中英文页自动同步 */}
  <PublicationSection publications={localizePublications('en')} />
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>
