body {
    background:url(/images/background.png);
    background-repeat: no-repeat;
    background-attachment: fixed; //是否滚动，fixed固定
    background-size: cover;      //填充
    background-position: center;
}
//文章背板的颜色：跟随主题（亮色白色 / 暗色深灰），保证文字可读
.main-inner > .sub-menu, .main-inner > .post-block, .main-inner > .tabs-comment, .main-inner > .comments, .main-inner > .pagination{
  background: var(--content-bg-color);
}
body{               //修改主体字体颜色
  font-size: 15px;  //整体字体稍微变小
}

//侧边框的透明度设置
.sidebar {
  opacity: 0.85;
}

//菜单栏的调色（跟随主题亮暗模式）
.header-inner {     
  background: var(--content-bg-color);
}
//搜索框透明
.popup {        
  opacity: 0.8;
}

.main-inner {
  background-color: var(--content-bg-color);  //主体背景跟随主题亮暗模式
    padding: 0px 20px 20px 20px;  //调整组件位置
}

.category-all .category-list {
  list-style: none;
  padding-left: 0;
}

.category-all .category-list-item {
  margin: 0.35em 0;
}

.category-all .category-list-item .category-toggle {
  display: inline-block;
  width: 1.2em;
  margin-right: 0.35em;
  color: #666;
  cursor: pointer;
  user-select: none;
  transition: transform 0.2s ease;
}

.category-all .category-list-item.expanded > .category-toggle {
  transform: rotate(90deg);
}

.category-all .category-list-child {
  margin-left: 1.8em;
  display: none;
}

.category-all .category-list-item.expanded > .category-list-child {
  display: block;
}

.category-all .category-post-link::before {
  content: '📄 ';
  font-style: normal;
}

.category-all .category-post-link {
  font-size: 0.92em;
  color: #555;
}